// Regole markdownlint per i file Markdown del kit (le usa anche l'estensione markdownlint dell'editor)
{
  "default": true,
  // un paragrafo per riga: niente a capo forzato a 80 colonne
  "MD013": false,
  // lo stesso titolo va bene sotto genitori diversi (es. "Pro" in ogni opzione)
  "MD024": { "siblings_only": true }
}
